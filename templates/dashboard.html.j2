<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portfolio Dashboard</title>
  <script src="https://cdn.plot.ly/plotly-2.27.0.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f8fafc; color: #1e293b; }

    .header { background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white; padding: 2rem; }
    .header h1 { font-size: 1.75rem; font-weight: 700; }
    .header p { opacity: 0.85; margin-top: 0.25rem; font-size: 0.9rem; }

    .summary-bar { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; padding: 1.25rem 2rem; background: white; border-bottom: 1px solid #e2e8f0; }
    .summary-card { text-align: center; padding: 0.5rem; }
    .summary-card .value { font-size: 1.6rem; font-weight: 700; color: #4f46e5; }
    .summary-card .label { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }

    .main { max-width: 1400px; margin: 0 auto; padding: 2rem; }
    .section-title { font-size: 1rem; font-weight: 600; color: #475569; margin-bottom: 1rem; padding-bottom: 0.4rem; border-bottom: 2px solid #e2e8f0; text-transform: uppercase; letter-spacing: 0.05em; }

    .grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem; }
    .grid-1 { margin-bottom: 2rem; }

    .card { background: white; border-radius: 12px; padding: 1.25rem 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
    .card-label { font-size: 0.8rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem; }
    .chart-container { width: 100%; min-height: 320px; }
    .chart-sm { min-height: 200px; }

    /* Cost basis table */
    .cb-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .cb-table th { text-align: left; padding: 0.5rem 0.75rem; color: #94a3b8; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #e2e8f0; }
    .cb-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid #f1f5f9; }
    .cb-table tr:last-child td { border-bottom: none; font-weight: 700; background: #f8fafc; }
    .gain-pos { color: #10b981; font-weight: 600; }
    .gain-neg { color: #ef4444; font-weight: 600; }
    .gain-na  { color: #94a3b8; }
    .cb-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
    @media (max-width: 800px) { .cb-layout { grid-template-columns: 1fr; } }

    .projection-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-top: 1.25rem; }
    .proj-stat { background: #f8fafc; border-radius: 8px; padding: 0.875rem; text-align: center; }
    .proj-stat .val { font-size: 1.2rem; font-weight: 700; color: #4f46e5; }
    .proj-stat .lbl { font-size: 0.72rem; color: #64748b; margin-top: 0.2rem; line-height: 1.4; }
    .proj-stat .sub { font-size: 0.7rem; color: #94a3b8; margin-top: 0.1rem; }

    .acct-rates { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
    .rate-badge { background: #f1f5f9; border-radius: 6px; padding: 0.3rem 0.6rem; font-size: 0.75rem; color: #475569; }
    .rate-badge span { font-weight: 700; color: #4f46e5; }

    .suggestions { display: flex; flex-direction: column; gap: 0.75rem; }
    .suggestion { display: flex; gap: 1rem; padding: 0.875rem 1rem; border-radius: 8px; align-items: flex-start; }
    .suggestion.high { background: #fef2f2; border-left: 4px solid #ef4444; }
    .suggestion.medium { background: #fffbeb; border-left: 4px solid #f59e0b; }
    .suggestion.info { background: #f0fdf4; border-left: 4px solid #10b981; }
    .suggestion .badge { font-size: 0.65rem; font-weight: 700; padding: 2px 7px; border-radius: 99px; white-space: nowrap; }
    .suggestion.high .badge { background: #ef4444; color: white; }
    .suggestion.medium .badge { background: #f59e0b; color: white; }
    .suggestion.info .badge { background: #10b981; color: white; }
    .suggestion .text { font-size: 0.875rem; line-height: 1.5; }
    .suggestion .account-tag { font-size: 0.72rem; font-weight: 600; color: #4f46e5; margin-bottom: 0.15rem; }

    footer { text-align: center; padding: 2rem; color: #94a3b8; font-size: 0.78rem; }

    @media (max-width: 600px) {
      .summary-bar { padding: 1rem; }
      .main { padding: 1rem; }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<div class="header">
  <h1>Portfolio Dashboard</h1>
  <p>Last updated: {{ generated_at }}</p>
</div>

<!-- Summary Bar -->
<div class="summary-bar">
  <div class="summary-card">
    <div class="value">${{ "{:,.0f}".format(current_total) }}</div>
    <div class="label">Total Portfolio</div>
  </div>
  {% set proj = analysis.projection %}
  <div class="summary-card">
    <div class="value">${{ "{:,.0f}".format(proj.projected_value_at_retirement) }}</div>
    <div class="label">Projected at Retirement</div>
  </div>
  <div class="summary-card">
    <div class="value">{{ proj.years_to_retirement }}</div>
    <div class="label">Years to Retirement</div>
  </div>
  <div class="summary-card">
    <div class="value">{{ "{:.1f}".format(proj.average_growth_rate * 100) }}%</div>
    <div class="label">Blended Growth Rate</div>
  </div>
  {% set tfsa = analysis.contribution_room.tfsa %}
  <div class="summary-card">
    <div class="value">${{ "{:,.0f}".format(tfsa.remaining_this_year or 0) }}</div>
    <div class="label">TFSA Room Remaining</div>
  </div>
  <div class="summary-card">
    {% set rrsp = analysis.contribution_room.rrsp %}
    <div class="value">${{ "{:,.0f}".format(rrsp.remaining_this_year or 0) }}</div>
    <div class="label">RRSP Room Remaining</div>
  </div>
</div>

<div class="main">

  <!-- Net Worth Over Time -->
  <div class="grid-1">
    <div class="card">
      <div class="card-label">Net Worth Over Time</div>
      <div class="chart-container" id="chart-net-worth"></div>
    </div>
  </div>

  <!-- Deposits vs Current Value -->
  {% set cb = analysis.cost_basis %}
  {% if cb %}
  <div class="section-title">Invested vs Current Value</div>
  <div class="card grid-1">
    <div class="cb-layout">
      <div>
        <div class="chart-container chart-sm" id="chart-cost-basis"></div>
      </div>
      <div>
        <table class="cb-table">
          <thead>
            <tr>
              <th>Account</th>
              <th>Invested</th>
              <th>Current Value</th>
              <th>Gain / Loss</th>
              <th>As of</th>
            </tr>
          </thead>
          <tbody>
            {% for row in cb %}
            <tr>
              <td>{{ row.label }}</td>
              <td>{% if row.book_value is not none %}${{ "{:,.0f}".format(row.book_value) }}{% else %}<span class="gain-na">—</span>{% endif %}</td>
              <td>${{ "{:,.0f}".format(row.current_value) }}</td>
              <td>
                {% if row.gain is not none %}
                  <span class="{{ 'gain-pos' if row.gain >= 0 else 'gain-neg' }}">
                    {{ '+' if row.gain >= 0 else '' }}${{ "{:,.0f}".format(row.gain) }}
                    {% if row.gain_pct is not none %}({{ "{:+.1f}".format(row.gain_pct) }}%){% endif %}
                  </span>
                {% else %}
                  <span class="gain-na">—</span>
                {% endif %}
              </td>
              <td style="color:#94a3b8;font-size:0.8rem;">{{ row.as_of or "—" }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}

  <!-- Asset Allocation -->
  <div class="section-title">Asset Allocation</div>
  <div class="grid-3">
    <div class="card">
      <div class="chart-container" id="chart-alloc-class"></div>
    </div>
    <div class="card">
      <div class="chart-container" id="chart-alloc-geo"></div>
    </div>
    <div class="card">
      <div class="chart-container" id="chart-alloc-acct"></div>
    </div>
  </div>

  <!-- Contribution Room -->
  <div class="section-title">Contribution Room</div>
  <div class="grid-2">
    <div class="card">
      <div class="chart-container chart-sm" id="chart-contrib-current"></div>
    </div>
    <div class="card">
      <div class="chart-container chart-sm" id="chart-contrib-prior"></div>
    </div>
  </div>

  <!-- Retirement Projection -->
  <div class="section-title">Retirement Projection</div>
  <div class="grid-1">
    <div class="card">
      <div class="chart-container" id="chart-projection"></div>

      <div class="projection-stats">
        <div class="proj-stat">
          <div class="val">${{ "{:,.0f}".format(proj.projected_value_at_retirement) }}</div>
          <div class="lbl">Portfolio at Retirement</div>
        </div>
        <div class="proj-stat">
          <div class="val">${{ "{:,.0f}".format(proj.projected_value_real) }}</div>
          <div class="lbl">In Today's Dollars</div>
        </div>
        <div class="proj-stat">
          <div class="val">{{ "{:.1f}".format(proj.average_growth_rate * 100) }}%</div>
          <div class="lbl">Blended Historical Rate</div>
          <div class="sub">From actual statements</div>
        </div>
        <div class="proj-stat">
          <div class="val">${{ "{:,.0f}".format(proj.annual_contribution) }}</div>
          <div class="lbl">Annual Contributions</div>
        </div>
        <div class="proj-stat">
          <div class="val">${{ "{:,.0f}".format(proj.annual_withdrawal) }}</div>
          <div class="lbl">Annual Withdrawal Plan</div>
        </div>
      </div>

      {% if proj.per_account_projections %}
      <div class="acct-rates">
        {% for acct in proj.per_account_projections %}
        <div class="rate-badge">{{ acct.label }}: <span>{{ "{:.1f}".format(acct.growth_rate * 100) }}%/yr</span></div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>

  <!-- Suggestions -->
  {% if analysis.suggestions %}
  <div class="section-title">Recommendations</div>
  <div class="card">
    <div class="suggestions">
      {% for s in analysis.suggestions %}
      <div class="suggestion {{ s.priority }}">
        <div>
          <span class="badge">{{ s.priority.upper() }}</span>
        </div>
        <div>
          <div class="account-tag">{{ s.account }}</div>
          <div class="text">{{ s.message }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>

<footer>
  Portfolio Dashboard &mdash; Generated {{ generated_at }} &mdash; For personal use only. Not financial advice.
</footer>

<script>
  var charts = {
    netWorth:       {{ charts.net_worth }},
    allocClass:     {{ charts.allocation.by_asset_class }},
    allocGeo:       {{ charts.allocation.by_geography }},
    allocAcct:      {{ charts.allocation.by_account }},
    contribCurrent: {{ charts.contribution_room_current }},
    contribPrior:   {{ charts.contribution_room_prior }},
    projection:     {{ charts.projection }},
    costBasis:      {{ charts.cost_basis }},
  };

  var cfg = {responsive: true, displayModeBar: false};

  function plot(id, chart) {
    if (chart && chart.data) Plotly.newPlot(id, chart.data, chart.layout, cfg);
  }

  plot("chart-net-worth",      charts.netWorth);
  plot("chart-alloc-class",    charts.allocClass);
  plot("chart-alloc-geo",      charts.allocGeo);
  plot("chart-alloc-acct",     charts.allocAcct);
  plot("chart-contrib-current",charts.contribCurrent);
  plot("chart-contrib-prior",  charts.contribPrior);
  plot("chart-projection",     charts.projection);
  plot("chart-cost-basis",     charts.costBasis);
</script>
</body>
</html>
